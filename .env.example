# ═══════════════════════════════════════════════════════════
# CESAROPS Core — Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# ── AI / LLM ──────────────────────────────────────────────
# Qwen (DashScope) API key for AI Director & LLM features
# Get one at: https://dashscope.console.aliyun.com/
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Google Gemini (free tier: 15 RPM, 1M tokens/day)
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Anthropic Claude (free tier via API key)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Groq Cloud (free tier: 30 RPM, fast LPU inference)
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── NASA Earthdata (SWOT, ICESat-2, Landsat) ─────────────
# Get one at: https://urs.earthdata.nasa.gov/
EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ── USGS Earth Explorer (Landsat archives) ───────────────
# Get one at: https://earthexplorer.usgs.gov/
USGS_API_KEY=

# ── Copernicus / Sentinel (Sentinel-1 SAR, Sentinel-2) ───
# Get one at: https://dataspace.copernicus.eu/
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# ── Remote Nodes (Pi & Xeon) ─────────────────────────────
PI_HOST=10.0.0.226
PI_USER=pi
PI_PASS=
PI_KEY=
PI_WORK=/home/pi/cesarops/sync

XENON_HOST=10.0.0.55
XENON_USER=cesarops
XENON_PASS=
XENON_KEY=
XENON_WORK=/home/cesarops/cesarops/sync

# ── TPU Server ────────────────────────────────────────────
TPU_SERVER_URL=http://localhost:5001

# ── Cloudflare Worker (command queue) ─────────────────────
CLOUDFLARE_API=https://your-worker.your-subdomain.workers.dev

# ── Data Paths ────────────────────────────────────────────
# Base directory for satellite imagery cache
DATA_BASE=C:\Users\thomf\programming\cesarops-wreckhunter build\wreckhunter2000\data\cache\census_raw
LANDSAT_DIR=${DATA_BASE}\2021_low_water
SENTINEL_DIR=${DATA_BASE}\2025_rossa

# ── Sentinel Hub (on-demand processing) ─────────────────
# Get one at: https://www.sentinel-hub.com/
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# ── OpenTopography (LiDAR via web portal) ────────────────
# Get one at: https://opentopography.org/
# Optional — USGS 3DEP via TNM API is free without a key
OPENTOPO_API_KEY=

# ── NOAA CoastWatch ERDDAP ───────────────────────────────
# Free, no key required — Great Lakes SST (GLSEA)
# https://coastwatch.glerl.noaa.gov/erddap/index.html
# (no credentials needed)

# ── Drive / Database ──────────────────────────────────────
DRIVE_PATH=C:\Users\thomf\programming\cesarops-wreckhunter build\wreckhunter2000
DB_PATH=${DRIVE_PATH}\LAKE_MICHIGAN_CENSUS_2026.db
